#!/usr/bin/env bash
# Product-repo pre-commit checks. Installed once per clone with `make hooks`
# (sets core.hooksPath to this directory). Skips gracefully in checkouts that
# lack the product layout (e.g. the platform repo itself).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ -d src ] && [ -f platform/scripts/check-layout.sh ]; then
    bash platform/scripts/check-layout.sh
fi
if [ -f selection.txt ] && [ -f platform/scripts/selection-reasons.sh ]; then
    bash platform/scripts/selection-reasons.sh --check
fi
